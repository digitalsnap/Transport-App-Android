<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declared now so the "trips" notification channel has a permission to
         pair with; the runtime request (API 33+) arrives with the push feature,
         since asking before there is anything to notify about just gets denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (API 30+) for the implicit intents the app resolves:
         opening links, sharing a ticket as text or PNG, adding a trip to the calendar. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/png" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <!-- allowBackup=false plus explicit exclude-all rules: the device identity,
         booking cart and cached tickets must never be restored onto another
         device. Revisit once passenger accounts exist server-side. -->
    <application
        android:name=".RideVibeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RideVibe"
        android:supportsRtl="true">

        <!-- singleTop: a deep link arriving while the activity is already on top
             is delivered to onNewIntent, where the nav controller handles it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RideVibe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App links: ridevibe://ticket/{ticketIds} opens a ticket,
                 ridevibe://booking opens My Bookings. No https host yet, so no
                 autoVerify; the scheme is enough for notifications and QR codes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ridevibe" android:host="ticket" />
                <data android:scheme="ridevibe" android:host="booking" />
            </intent-filter>
        </activity>

        <!-- Facebook Login. Auto-init stays off: the SDK is initialised on demand
             by the Welcome screen, and never when facebook_app_id is blank. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <!-- The Facebook SDK's own manifest declares CustomTabActivity with a
             cct.<applicationId> host filter and tools:node="merge"; this entry
             merges in the fb<APP_ID> scheme the Custom Tab login flow returns
             on (per the Facebook Login for Android setup guide). Keep both. -->
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>
    </application>

</manifest>
