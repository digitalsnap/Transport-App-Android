<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Save to device" on API 24–28 writes straight to the public Pictures
         folder. From API 29 MediaStore scopes the write and needs nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Hands the rendered ticket PNG (cacheDir/shared-tickets/) to the
             share sheet without exposing a file:// path. The authority is
             suffixed so it can never collide with a provider another module
             or a library declares under the bare applicationId. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.tickets.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ticket_share_paths" />
        </provider>
    </application>

</manifest>
