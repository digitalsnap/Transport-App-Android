# Copy this file to keystore.properties (gitignored) and fill in the two blank
# password values with the password you set when generating the keystore.
# Full walkthrough: RELEASING.md, Part 1 Steps 1-2.
#
# Formatting rules — these are the usual causes of "password was incorrect":
#   * No quotes around the value.        storePassword=hunter2   NOT "hunter2"
#   * No spaces around the = sign.
#   * No trailing spaces after the value (invisible, and it will break).
#   * A backslash in the password must be doubled:  pa\\ss
#
# storeFile is resolved relative to the app/ module, so ../ is the repo root —
# leave it as-is if you ran keytool from the repo root as the guide instructs.
storeFile=../ridevibe-upload.jks
storePassword=
keyAlias=ridevibe-upload
keyPassword=
